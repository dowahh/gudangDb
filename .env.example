APP_NAME="Sistem Manajemen Inventaris Gudang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Contoh lokal : http://localhost:8000
# Contoh live  : https://app-anda.wasmer.dev
APP_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr supaya log keluar di stream/console hosting (Wasmer Edge)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Koneksi MySQL (TiDB Cloud di project ini; lokal bisa mysql biasa)
DB_CONNECTION=mysql
# Contoh TiDB: gateway01.asia-southeast1.prod.tidbcloud.com
DB_HOST=
DB_PORT=4000
DB_DATABASE=GudangDb
# Contoh TiDB: 3xxxxxxx.root
DB_USERNAME=
DB_PASSWORD=
# TiDB Cloud wajib SSL: isi path ke sertifikat CA (ISRG Root X1).
# Path beda antara Windows lokal dan Linux server, contoh:
#   Windows lokal : C:\xampp\php\extras\ssl\cacert.pem
#   Linux server  : /etc/ssl/certs/ca-certificates.crt
# Isi sesuai sistem yang menjalankan aplikasi, jangan dua-duanya.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# SESSION_DRIVER=cookie dipilih karena TIDAK ADA tabel sessions di database
# (DB udah production ter-seed, nggak mau nambah tabel). Data session
# disimpan di cookie browser + dienkripsi (SESSION_ENCRYPT=true).
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# CACHE_STORE=file dipilih karena alasannya sama: tidak ada tabel cache
# di database, cukup file di storage/framework/cache.
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
